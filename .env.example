# LLM-AVChain Proof-of-Concept Configuration
# Copy to .env and update values as needed.

# Database
DATABASE_URL=sqlite:///./data/ledger.db

# Evidence store
EVIDENCE_DIR=./data/evidence
VALIDATOR_REGISTRY_PATH=runtime/validators.yaml

# Local LLM integration
LLM_PROVIDER=disabled
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL_VALIDATOR=validator-local-model
LMSTUDIO_MODEL_ENDPOINT=endpoint-local-model
LMSTUDIO_TIMEOUT_SECONDS=30
LMSTUDIO_MAX_RETRIES=1
LLM_JSON_MODE=true

# API keys (replace with secure random strings for non-dev use)
LEDGER_API_KEY=dev-ledger-key
EVIDENCE_API_KEY=dev-evidence-key
CONSENSUS_API_KEY=dev-consensus-key
COVERAGE_API_KEY=dev-coverage-key
AGENT_API_KEY=dev-agent-key

# Consensus
QUORUM_THRESHOLD=0.5
COVERAGE_THRESHOLD=0.6

# Timing
POLL_INTERVAL=30
TELEMETRY_RATE=1
SUSPECTED_TIMEOUT_HOURS=24
REVIEW_TIMEOUT_HOURS=24

# Agent
REMEDIATION_ACTION=log
ENDPOINT_SCAN_ENABLED=false
ENDPOINT_WATCH_DIR=
ENDPOINT_QUARANTINE_DIR=runtime/quarantine
ENDPOINT_MAX_FILE_SIZE_BYTES=262144
ENDPOINT_PROCESS_EVENTS_PATH=
ENDPOINT_PACKAGE_EVENTS_PATH=
ENDPOINT_NETWORK_EVENTS_PATH=
ENDPOINT_NATIVE_SNAPSHOT_ENABLED=false
ENDPOINT_NATIVE_SNAPSHOT_LIMIT=25
ENDPOINT_SIGNING_ENABLED=false
ENDPOINT_ID=endpoint-agent
ENDPOINT_PRIVATE_KEY_PATH=runtime/keys/endpoint-agent_key.pem

# Service ports
PORT_LEDGER=8000
PORT_EVIDENCE=8001
PORT_CONSENSUS=8002
PORT_COVERAGE=8003
PORT_AGENT=8004

# Service base URLs (for inter-service communication)
LEDGER_BASE_URL=http://127.0.0.1:8000
EVIDENCE_BASE_URL=http://127.0.0.1:8001
CONSENSUS_BASE_URL=http://127.0.0.1:8002
COVERAGE_BASE_URL=http://127.0.0.1:8003

# TAXII publication
TAXII_BASE_URL=
TAXII_COLLECTION_ID=default
TAXII_API_KEY=
